{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alify",
  "version": "0.1.0",
  "identifier": "app.alify.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Alify",
        "url": "index.html",
        "width": 1180,
        "height": 740,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true,
        "center": true
      },
      {
        "label": "floating",
        "title": "Alify Flotante",
        "url": "floating.html",
        "minWidth": 240,
        "minHeight": 96,
        "width": 380,
        "height": 130,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https://*.mzstatic.com https://coverartarchive.org https://*.scdn.co https://*.spotifycdn.com https://*.googleusercontent.com https://*.ytimg.com https://*.sndcdn.com https://*.dzcdn.net https://*.tidal.com; media-src 'self' blob: asset: http://asset.localhost https://p.scdn.co; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost ws://localhost:1420 https://lrclib.net https://itunes.apple.com https://coverartarchive.org; font-src 'self' data:",
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
